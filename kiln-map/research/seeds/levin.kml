<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Wood Kilns</name>
    <description><![CDATA[A public resource of wood fired kilns around the world.  Any type of wood kiln for pottery is accepted.  <br>If you are interested in adding yours to the map please email Simon@SimonLevin.com Send the Name of the kiln, Type of kiln, Size in Cubic feet, date of construction, contact information and any website where more information may be found.<br><br>Anagamas - Blue<br>Fast fire kilns - Yellow<br>Train Kilns - Green<br>Cross Drafts - Red<br>Groundhogs - Purple<br>Noborigama - White<br>Tube Kiln-Orange]]></description>
