      <Placemark>
        <name>Mill Creek Pottery-Anagama</name>
        <description><![CDATA[Contact:<br>Simon Levin<br>simonlevin.com<br> (http://www.woodfire.com)<br>Kilns:<br>1 60 cubic foot cross draft<br>1 18&#39; 200 cubic foot anagama<br>1 60 cubic foot modified train kiln]]></description>
        <styleUrl>#icon-503-4186F0</styleUrl>
        <Point>
          <coordinates>
            -88.830246,44.817235,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Gustin Ceramics</name>
        <description><![CDATA[Type of Kiln - Anagama, with catenary salt/soda second chamber, catenary third chamber.<br>Size in Cubic Feet - Anagama (250 cu. ft), 2nd chamber (100 cu. ft), 3rd chamber (25 cubic feet) = 375 cubic feet total <br><br><br>Contact: Chris Gustin<br><br><br>Gustin Ceramics, LLC<br>231 Horseneck Road<br>South Dartmouth, MA 02748<br>508.636.6213<br>508.636.5099 fax<br>cgceramics@aol.com (cgceramics@aol.com)<br>www.gustinceramics.com (http://www.gustinceramics.com)]]></description>
        <styleUrl>#icon-503-FFFFFF</styleUrl>
        <Point>
          <coordinates>
            -71.046259,41.563668,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Lamplight Pottery Sprung Arch</name>
        <description><![CDATA[Sprung Arch<br>36 cu ft<br>N 7041 Northstar Rd<br>Michael Carson<br>Website: http://www.etsy.com/shop/lamplightpottery (http://www.etsy.com/shop/lamplightpottery)]]></description>
        <styleUrl>#icon-503-F4EB37</styleUrl>
        <Point>
          <coordinates>
            -87.812412,43.803237,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>PrattMWP Anagama</name>
        <description><![CDATA[designed by Bryan McGrath<br><br>60 cubic ft; built 2007<br><br><br><br>Munson-Williams-Proctor Arts Institute<br><br>School of Art<br><br>310 Genesee St.<br><br>Utica, NY  13501<br><br><br><br>Contacts- bmcgrath@mwpai.edu (mailto:bmcgrath@mwpai.edu);<br><br>              prattmwpclay.blogspot.com (http://prattmwpclay.blogspot.com)<br>mwpai.org (http://mwpai.org) or prattmwp.edu (http://prattmwp.edu)]]></description>
        <styleUrl>#icon-22</styleUrl>
