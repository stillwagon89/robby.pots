# Cloudflare Pages caches static assets aggressively by default (styles.css
# was seeing max-age=14400 — 4 hours). That's fine for images, but styles.css
# and gallery.js change often and a stale cached copy paired with fresh HTML
# breaks the page for anyone who loaded the site recently. Force these two to
# always revalidate, same as HTML pages already do, so a deploy is visible on
# the very next load instead of up to 4 hours later.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/gallery.js
  Cache-Control: public, max-age=0, must-revalidate
