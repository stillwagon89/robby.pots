{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robbypots-ceramics-chat",
  "pages_build_output_dir": "site",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "CERAMICS_DB",
      "database_name": "ceramics-db",
      "database_id": "b42e76c2-d340-48c9-b4bb-96a7ffc579a5"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ceramics-prose"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7d398a31195540dfa7840bcae07962d9"
    },
    {
      "binding": "GALLERY_CACHE",
      "id": "7b0f4b621ce34b8690381da48a85397f"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "SQUARE_CATEGORY_NAME": "Website",
    "SQUARE_LOCATION_ID": "L4P32PG0CC72F"
  }
}
